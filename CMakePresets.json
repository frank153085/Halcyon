{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 28,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-msvc-base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "CMAKE_C_COMPILER": "cl",
        "CMAKE_CXX_COMPILER": "cl",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON",
        "HALCYON_BUILD_TESTS": "ON",
        "HALCYON_ENABLE_VALIDATION": "ON",
        "HALCYON_BUILD_FRAMEGRAPH": "ON"
      }
    },
    {
      "name": "windows-msvc-debug",
      "displayName": "Windows MSVC Debug",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-msvc-relwithdebinfo",
      "displayName": "Windows MSVC RelWithDebInfo",
      "inherits": "windows-msvc-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HALCYON_ENABLE_VALIDATION": "OFF"
      }
    },
    {
      "name": "demo-msvc-debug",
      "displayName": "Demo Windows MSVC Debug",
      "inherits": "windows-msvc-base",
      "binaryDir": "${sourceDir}/out/build/demo-msvc-debug",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "demo-msvc-relwithdebinfo",
      "displayName": "Demo Windows MSVC RelWithDebInfo",
      "inherits": "windows-msvc-base",
      "binaryDir": "${sourceDir}/out/build/demo-msvc-relwithdebinfo",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "HALCYON_ENABLE_VALIDATION": "OFF"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug"
    },
    {
      "name": "windows-msvc-relwithdebinfo",
      "configurePreset": "windows-msvc-relwithdebinfo"
    },
    {
      "name": "demo-msvc-debug",
      "configurePreset": "demo-msvc-debug"
    },
    {
      "name": "demo-msvc-relwithdebinfo",
      "configurePreset": "demo-msvc-relwithdebinfo"
    }
  ],
  "testPresets": [
    {
      "name": "windows-msvc-debug",
      "configurePreset": "windows-msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "windows-msvc-relwithdebinfo",
      "configurePreset": "windows-msvc-relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "demo-msvc-debug",
      "configurePreset": "demo-msvc-debug",
      "output": {
        "outputOnFailure": true
      }
    },
    {
      "name": "demo-msvc-relwithdebinfo",
      "configurePreset": "demo-msvc-relwithdebinfo",
      "output": {
        "outputOnFailure": true
      }
    }
  ]
}
